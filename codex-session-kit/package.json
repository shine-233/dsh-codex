{
  "name": "codex-session-kit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Session rollout readers, migration and memory kit (from openai/codex formats)",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.3-alpha.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "@types/node": "22.20.1"
  },
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "NOTICE.md",
    "README.md"
  ]
}
