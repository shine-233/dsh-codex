{
  "name": "codex-config-importer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "One-shot codex config.toml -> cordis.patch.yml migrator + commons",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
